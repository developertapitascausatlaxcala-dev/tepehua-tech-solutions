---
interface Props {
  title: string;
  price: string;
  features: string[];
  ctaLabel: string;
  ctaHref: string;
}

const { title, price, features, ctaLabel, ctaHref } = Astro.props;
---

<div class="bg-card-surface rounded-2xl p-8 border border-[#1E3E62]/50 shadow-lg shadow-black/10 flex flex-col h-full">
  <header class="mb-6">
    <h3 class="text-xl font-bold text-text-light">{title}</h3>
    <p class="text-accent-cyan text-lg font-semibold mt-2">{price}</p>
  </header>

  <ul class="flex-1 space-y-3 text-text-muted">
    {features.map((feature) => (
      <li key={feature} class="flex items-start gap-2">
        <span class="text-accent-cyan">•</span>
        <span>{feature}</span>
      </li>
    ))}
  </ul>

  <a
    href={ctaHref}
    class="mt-auto w-full bg-accent-cyan text-bg-server px-6 py-3 rounded-lg font-semibold text-center hover:bg-[#00B8DE] transition-all transform hover:scale-105"
    >{ctaLabel}
  </a>
</div>