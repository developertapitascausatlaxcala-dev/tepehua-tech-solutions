---
    import Layout from '../layouts/Layout.astro';
    ---
    
    <Layout title="Contacto | Tepehua Tech Solutions">
      <main class="max-w-6xl mx-auto px-6 py-16">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-text-light mb-4">Contacto</h1>
        <p class="text-text-muted mb-12">Estamos en Tlaxcala. Hablemos de tu proyecto.</p>
    
        <div class="grid md:grid-cols-2 gap-12">
          <section aria-label="Canales de contacto">
            <h2 class="text-xl font-bold text-text-light mb-4">Canales directos</h2>
            <ul class="space-y-3 text-text-muted">
              <li><strong>Ubicación:</strong> Tlaxcala, Tlaxcala</li>
              <li><strong>Email:</strong> contacto@tepehuatech.com</li>
              <li><strong>WhatsApp:</strong> <a href="#" class="text-accent-cyan hover:underline">Ver WhatsApp Business</a></li>
              <li><strong>Horario:</strong> Lunes a Viernes, 9:00 — 18:00</li>
            </ul>
          </section>
    
          <section aria-label="Formulario de contacto">
            <!-- HubSpot form embed -->
            <script src="https://js.hsforms.net/forms/embed/52150652.js" defer></script>
            <div class="hs-form-frame" data-region="na1" data-form-id="5a60e0da-e70d-4764-a42f-3eb6132fdd10" data-portal-id="52150652"></div>
          </section>
        </div>
      </main>
    </Layout>
