---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeatureCard from '../components/FeatureCard.astro';
---

<Layout title="Tepehua Tech Solutions — Desarrollo de sistemas y automatización">
  <Hero
    headline="Sistemas robustos, desarrollo de software personalizado y automatización inteligente para tu negocio."
    subtitle="Transformamos desafíos operativos complejos en soluciones de software seguras, escalables y 100% bajo tu control."
  />

  <section class="max-w-6xl mx-auto px-6 py-16" aria-label="Pilares de autoridad">
    <h2 class="text-3xl font-bold tracking-tight text-text-light mb-2">Autoridad técnica</h2>
    <p class="text-text-muted mb-12">Tres pilares que definen nuestra entrega.</p>

    <div class="grid md:grid-cols-3 gap-8">
      <FeatureCard
        title="Arquitectura crítica"
        description="Full-Stack robusto con Node.js, Astro, Angular, NestJS, Go y .NET. Creación de sistemas resilientes para entornos institucionales."
      />
      <FeatureCard
        title="Privacidad y control local"
        description="Bases de datos locales seguras (SQLite, PostgreSQL) con cero dependencia obligatoria de nubes vulnerables. Tu datos permanecen contigo."
      />
      <FeatureCard
        title="Automatización inteligente"
        description="Conexión directa de flujos de trabajo con herramientas de mensajería (WhatsApp Business API / Desktop) sin intermediarios."
      />
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16" aria-label="Nuestras soluciones">
    <h2 class="text-3xl font-bold tracking-tight text-text-light mb-2">Soluciones</h2>
    <p class="text-text-muted mb-10">Productos desarrollados por Tepehua Tech Solutions.</p>

    <div class="grid md:grid-cols-2 gap-8">
      <a href="/soluciones/mensajero-pro" class="group bg-gradient-to-br from-[#1E3E62]/60 to-[#0B192C]/80 rounded-3xl p-8 border border-[#1E3E62]/40 hover:border-accent-cyan/40 transition-all shadow-xl shadow-black/10 flex flex-col">
        <span class="text-xs font-medium text-accent-cyan mb-3">SaaS para verificación</span>
        <h3 class="text-2xl font-bold text-text-light mb-3 group-hover:text-accent-cyan transition-colors">Mensajero Pro</h3>
        <p class="text-text-muted mb-5 leading-relaxed">Gestión inteligente y alertas automáticas para centros de verificación vehicular. Cálculo preciso por color y placa, datos locales 100% en SQLite y despacho por WhatsApp.</p>
        <span class="inline-flex items-center gap-2 text-sm font-semibold text-accent-cyan mt-auto">Ver solución <span class="group-hover:translate-x-1 transition-transform">→</span></span>
      </a>

      <a href="/soluciones/tkd-flow" class="group bg-gradient-to-br from-[#1E3E62]/60 to-[#0B192C]/80 rounded-3xl p-8 border border-[#1E3E62]/40 hover:border-accent-cyan/40 transition-all shadow-xl shadow-black/10 flex flex-col">
        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-accent-cyan mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span> Nuevo SaaS
        </span>
        <h3 class="text-2xl font-bold text-text-light mb-3 group-hover:text-accent-cyan transition-colors">TKD Flow</h3>
        <p class="text-text-muted mb-5 leading-relaxed">Plataforma de gestión para escuelas de Taekwondo: asistencia digital, cobros automáticos, progresión de cintas, inventario POS y notificaciones WhatsApp con demo de 15/30/45 días.</p>
        <span class="inline-flex items-center gap-2 text-sm font-semibold text-accent-cyan mt-auto">Ver solución <span class="group-hover:translate-x-1 transition-transform">→</span></span>
      </a>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16 bg-gradient-to-r from-[#1E3E62]/30 to-[#0B192C]/60 rounded-3xl border border-[#1E3E62]/50" aria-label="Mensajero Pro destacado">
    <div class="flex flex-col md:flex-row gap-12 items-center">
      <div class="flex-1">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-text-light mb-4">Mensajero Pro</h2>
        <p class="text-text-muted mb-4 leading-relaxed">
          Centro de verificación inteligente con cálculo automático de fechas de vencimiento mediante algoritmo basado en color de calcomanía y terminación de placa. Datos locales, privacidad absoluta.
        </p>
        <ul class="text-text-muted list-disc pl-5 space-y-1 mb-6">
          <li>Cálculo preciso por algoritmo</li>
          <li>100% local en SQLite</li>
          <li>Despacho automático por WhatsApp</li>
        </ul>
        <a href="/soluciones/mensajero-pro" class="inline-block bg-accent-cyan text-bg-server px-6 py-3 rounded-lg font-semibold hover:bg-[#00B8DE] transition-all shadow-[0_0_15px_rgba(0,209,255,0.3)]">Ver solución</a>
      </div>
      <div class="w-full md:w-1/3 bg-card-surface rounded-2xl p-6 shadow-2xl shadow-black/20 border border-[#1E3E62]/50">
        <h3 class="font-bold text-text-light mb-3">Estado del sistema</h3>
        <div class="flex gap-4 text-sm">
          <div><span class="block font-bold text-white text-xl">0</span>Recordatorios pendientes</div>
          <div><span class="block font-bold text-white text-xl">100%</span>Local</div>
        </div>
      </div>
    </div>
  </section>
</Layout>
