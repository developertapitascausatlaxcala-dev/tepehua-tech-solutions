---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Gracias | Tepehua Tech Solutions">
  <main class="max-w-6xl mx-auto px-6 py-16">
    <h1 class="text-4xl md:text-5xl font-bold text-text-light mb-4">¡Gracias!</h1>
    <p class="text-text-light mb-8">Gracias por enviar tu mensaje. Nos pondremos en contacto contigo pronto.</p>
    <p class="text-text-muted text-sm">
      <a href="/contacto" class="text-accent-cyan hover:text-accent-cyan-hover">Volver al formulario</a>
    </p>
  </main>
</Layout>